module uart_rx #(
    parameter int BAUD_DIV = 10416
)(
    input  logic clk,
    input logic rst_n,
    input logic rx,
    output logic [7:0] data_out,
    output logic rx_done,
    output logic rx_busy
);


    localparam int HALF_BAUD_DIV = BAUD_DIV / 2;
    // Internal Signals
    

    logic [2:0]  bit_cnt;
    logic [7:0]  shifter;
    logic [15:0] baud_cnt;

    logic        baud_tick;
    logic        half_baud;

    logic        prev_rx;
    logic        falling_edge;


    
    // State Machine
    

    typedef enum logic [1:0] {
        IDLE,
        START,
        DATA,
        STOP
    } state_t;

    state_t state;
    state_t next_state;


    
    // Status
    

    assign rx_busy = (state != IDLE);


  
    // State Register
  

    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n)
            state <= IDLE;
        else
            state <= next_state;
    end


    
    // RX Falling-Edge Detector
    

    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n)
            prev_rx <= 1'b1;
        else
            prev_rx <= rx;
    end

    assign falling_edge = prev_rx && !rx;


  
    // Next-State Logic
  

    always_comb begin
        next_state = state;

        case (state)

            IDLE: begin
                if (falling_edge)
                    next_state = START;
            end

            START: begin
                if (half_baud)
                    next_state = DATA;
            end

            DATA: begin
                if (baud_tick && (bit_cnt == 3'd7))
                    next_state = STOP;
            end

            STOP: begin
                if (baud_tick)
                    next_state = IDLE;
            end

            default: begin
                next_state = IDLE;
            end

        endcase
    end


    
    // Baud Counter
    
    assign half_baud = (baud_cnt == HALF_BAUD_DIV - 16'd1);

    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            baud_cnt  <= 16'd0;
            baud_tick <= 1'b0;
        end
        else if (state == IDLE) begin
            baud_cnt  <= 16'd0;
            baud_tick <= 1'b0;
        end
        else if (baud_cnt == (BAUD_DIV - 1)) begin
            baud_cnt  <= 16'd0;
            baud_tick <= 1'b1;
        end
        else begin
            baud_cnt  <= baud_cnt + 16'd1;
            baud_tick <= 1'b0;
        end
    end


  
    // Bit Counter
  
    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            bit_cnt <= 3'd0;
        end
        else if (state == IDLE) begin
            bit_cnt <= 3'd0;
        end
        else if (state == DATA && baud_tick && (bit_cnt != 3'd7)) begin
            bit_cnt <= bit_cnt + 3'd1;
        end
    end


    
    // Receive Shift Register
    

    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            shifter <= 8'd0;
        end
        else if (state == IDLE) begin
            shifter <= 8'd0;
        end
        else if (state == DATA && baud_tick) begin
            shifter[bit_cnt] <= rx;
        end
    end


    
    // Data Output Register
    
    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            data_out <= 8'd0;
        end
        else if (state == DATA &&
                 baud_tick &&
                 (bit_cnt == 3'd7)) begin

            data_out <= {rx, shifter[6:0]};
        end
    end


    
    // Receive Done
    

    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n)
            rx_done <= 1'b0;
        else
            rx_done <= (state == STOP && baud_tick);
    end

endmodule
